@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/nocloomCoreTargets.cmake")
set(nocloom_Core_FOUND TRUE)
set(nocloom_Config_FOUND FALSE)
set(nocloom_IO_FOUND FALSE)
if(NOT nocloom_FIND_COMPONENTS)
  set(nocloom_FIND_COMPONENTS Core)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/nocloomConfigTargets.cmake")
    list(APPEND nocloom_FIND_COMPONENTS Config IO)
  endif()
endif()
if("Config" IN_LIST nocloom_FIND_COMPONENTS OR "IO" IN_LIST nocloom_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/nocloomConfigTargets.cmake")
    find_dependency(yaml-cpp 0.8.0 CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/nocloomConfigTargets.cmake")
    set(nocloom_Config_FOUND TRUE)
    set(nocloom_IO_FOUND TRUE)
  endif()
endif()
if(NOT TARGET nocloom::nocloom)
  add_library(nocloom::nocloom INTERFACE IMPORTED)
  set_property(TARGET nocloom::nocloom PROPERTY INTERFACE_LINK_LIBRARIES nocloom::core)
endif()
if(TARGET nocloom::io)
  set_property(TARGET nocloom::nocloom PROPERTY INTERFACE_LINK_LIBRARIES nocloom::io)
endif()
check_required_components(nocloom)
